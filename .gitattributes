# Normalize text; files that run on the Pi must stay LF regardless of the checkout platform.
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.sql text eol=lf
